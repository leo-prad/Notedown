{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notedown",
  "version": "0.1.0",
  "identifier": "com.pradd.notedown",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Notedown",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "A tabbed Markdown and text editor.",
    "longDescription": "Notedown is a tabbed Markdown and text editor with live preview, source mode, and unsaved-session persistence.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Notedown Markdown document",
        "description": "Notedown Markdown document",
        "role": "Editor"
      },
      {
        "ext": ["txt"],
        "name": "Notedown text document",
        "description": "Notedown text document",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
